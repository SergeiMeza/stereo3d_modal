# Copy to .env.local. Nothing here is secret: the Firebase web config is
# public by design and the gateway URL is public.
#
# Gateway the console calls. The test gateway admits http://localhost:5174.
VITE_GATEWAY_URL=https://stereo3d-gateway-test-151335782809.us-central1.run.app
# Label shown next to "admin" in the header (test | prod).
VITE_ENV_LABEL=test
