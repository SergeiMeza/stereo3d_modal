# Copy to .env (git-ignored). `make env` fills it from the key files in ~/dev without printing them.
APP_NAME="Stereo3D Studio"
# Firestore: the gateway's records (gateway/internal/store). The Spatial Video Studio KPI's read-only
# service account (roles/datastore.viewer) on the same GCP project, mounted read-only into the ingest
# container. Leave the path empty and the Firestore sources skip.
FIRESTORE_SA_FILE=
FIRESTORE_PROJECT=spatial-video-studio
# conversions_<env>, projects_<env>, customers_<env>, billing_batches_<env>
FIRESTORE_ENV=prod
# Vercel Web Analytics of the website (project stereo3d-studio). A token that can read that project;
# `make env` copies VERCEL_TOKEN from ~/dev/s3d-kpi-vercel.env when it exists. Empty: the source skips.
VERCEL_TOKEN=
# How often the ingest loop runs a full pass, in hours (Refresh on the dashboard queues one any time).
INGEST_INTERVAL_HOURS=1
# Where the database and its dumps live: on the external SSD, never in a Docker volume.
KPI_DATA_DIR=/Volumes/Dev/Data/s3d-kpi
# Where the dashboard listens: 127.0.0.1 keeps it to this Mac (there is no login on it).
KPI_BIND=127.0.0.1
