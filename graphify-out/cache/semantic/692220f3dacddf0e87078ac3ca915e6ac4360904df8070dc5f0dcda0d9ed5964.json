{"nodes": [{"id": "previews_compare_comparison_comparison", "label": "Inpainting + Depth Backend Comparison (2026-06-13)", "file_type": "document", "source_file": "previews/compare/COMPARISON.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "previews_compare_comparison_propainter", "label": "ProPainter Flow-Fill Inpainter", "file_type": "concept", "source_file": "previews/compare/COMPARISON.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cleaner silhouettes with mild flow-fill smear in holes; no hallucinations; rated best (8-10) in subjective A/B tests but ~3x slower than M2SVid."}, {"id": "previews_compare_comparison_m2svid", "label": "M2SVid Diffusion Inpainter", "file_type": "concept", "source_file": "previews/compare/COMPARISON.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~3x faster than ProPainter but introduces hallucinations/ghosting: white fuzz along high-contrast disocclusion stripes at 512-tier working res, milder at qhd. Levers: higher work res or the no_full_attention checkpoint variant. Native right-eye-only; both-eye needs the mirror trick."}, {"id": "previews_compare_comparison_vda", "label": "VDA Depth Model", "file_type": "concept", "source_file": "previews/compare/COMPARISON.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "previews_compare_comparison_da3", "label": "DA3 Depth Model", "file_type": "concept", "source_file": "previews/compare/COMPARISON.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needed two fixes: per-scene alignment anchored to the scene's FIRST frame with a scale guard (chained alignment collapsed to flat gray) and p0.5/p99.5 percentile normalization (min-max was crushed by outlier frames)."}, {"id": "previews_compare_comparison_da3_metric", "label": "DA3-Metric Depth Model", "file_type": "concept", "source_file": "previews/compare/COMPARISON.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives consistent cross-scene disparity (job-wide p1/p99 range) but showed a model failure predicting the closest dancer as far (solid black) \u2014 a model error, not pipeline overflow; relative mode is immune. Still used internally by the adaptive depth-script profiler for analysis keyframes only."}, {"id": "previews_compare_comparison_depth_pro", "label": "Depth Pro Profiler/Backend", "file_type": "concept", "source_file": "previews/compare/COMPARISON.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth Pro as a depth backend stays on branch depth-pro-backend, unmerged; but it serves as the per-shot profiler (profiler: depth-pro) in v3 adaptive depth scripts."}, {"id": "previews_compare_comparison_mirror_trick", "label": "Horizontal-Mirror Trick for Both-Eye M2SVid", "file_type": "rationale", "source_file": "previews/compare/COMPARISON.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M2SVid is a left-reference model; the left eye is synthesized by horizontally mirroring so the same model can be reused. Verified genuinely synthesized (mean |diff| vs pristine = 12.9; a stale-container run showing 0.89 was passthrough). Costs ~2x single-eye (239s vs 133s). Text/logos would mirror-degrade most."}, {"id": "previews_compare_comparison_vda_only_decision", "label": "Decision: VDA-Only Depth Model (2026-06-13)", "file_type": "rationale", "source_file": "previews/compare/COMPARISON.md", "source_location": "line 38-41", "source_url": null, "captured_at": null, "author": "Sergei", "contributor": null, "rationale": "Sergei decided depth model = VDA only for now. DA3/DA3-metric endpoints stay available but unused (da3-metric kept internally for the adaptive profiler's analysis keyframes); Depth Pro backend stays on unmerged branch depth-pro-backend."}], "edges": [{"source": "previews_compare_comparison_comparison", "target": "previews_compare_comparison_propainter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "previews/compare/COMPARISON.md", "source_location": null, "weight": 1.0}, {"source": "previews_compare_comparison_comparison", "target": "previews_compare_comparison_m2svid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "previews/compare/COMPARISON.md", "source_location": null, "weight": 1.0}, {"source": "previews_compare_comparison_comparison", "target": "previews_compare_comparison_vda", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "previews/compare/COMPARISON.md", "source_location": null, "weight": 1.0}, {"source": "previews_compare_comparison_comparison", "target": "previews_compare_comparison_da3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "previews/compare/COMPARISON.md", "source_location": null, "weight": 1.0}, {"source": "previews_compare_comparison_comparison", "target": "previews_compare_comparison_da3_metric", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "previews/compare/COMPARISON.md", "source_location": null, "weight": 1.0}, {"source": "previews_compare_comparison_comparison", "target": "previews_compare_comparison_depth_pro", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "previews/compare/COMPARISON.md", "source_location": null, "weight": 1.0}, {"source": "previews_compare_comparison_comparison", "target": "previews_compare_comparison_mirror_trick", "relation": "references", "confidence": "EXTRACTED"