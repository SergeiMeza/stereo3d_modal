{"nodes": [{"id": "previews_v7_dualres_test_test_summary_v7_test_summary", "label": "v7 Dual-Res GPU Validation Test Summary", "file_type": "document", "source_file": "previews/v7_dualres_test/TEST_SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "previews_v7_dualres_test_test_summary_dual_res_4k_splat", "label": "v7 Dual-Resolution 4K Splat", "file_type": "rationale", "rationale": "Splat (warp) runs at native output resolution (3840x2160) while inpainting runs at a cheap low resolution (1280x720): ~95% of the frame is real warped 4K detail and only disocclusion holes at depth edges carry upscaled-from-720 fill. Stereo GPU routed by splat pixels (H200 at splat_px=8294400, no OOM); frame counts match between splat and work streams so AV sync holds; output 7680x2160 true 4K SBS. ProPainter path GPU-verified and ready to merge; M2SVid path implemented but not 4K-tested; default path byte-identical.", "source_file": "previews/v7_dualres_test/TEST_SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "previews_v7_dualres_test_test_summary_content_addressed_auto_reuse", "label": "Content-Addressed Preprocess Auto-Reuse", "file_type": "rationale", "rationale": "Preprocess artifacts are keyed by a deterministic content-addressed hash (same request -> same key, e.g. preprocess:db2b36a02a49...); an identical request auto-reuses preprocess and scene-cut results with no job id passed, skipping preprocess and scene detection entirely. The dual-res splat surface is also published and registered for reuse.", "source_file": "previews/v7_dualres_test/TEST_SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "previews_v7_dualres_test_test_summary_v7_test_summary", "target": "previews_v7_dualres_test_test_summary_dual_res_4k_splat", "relation": "references",