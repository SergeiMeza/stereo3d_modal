{"nodes": [{"id": "previews_full_batch_v4_readme_full_batch_v4_overview", "label": "full_batch_v4 README (batch overview)", "file_type": "document", "source_file": "previews/full_batch_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "previews_full_batch_v4_readme_continuous_displacement_ramp", "label": "v4 Continuous Displacement Ramp by Median Depth", "file_type": "rationale", "rationale": "Displacement becomes a continuous function of median depth in meters (2m->0.010, 5m->0.008, 11m->0.006, 20m->0.0045 floor), applied per-shot AND per dynamic-keyframe; shot class now sets placement only. Fixes far-shot over-displacement (dance first shot at 14.9m was 0.007 flat, now ~0.0053).", "source_file": "previews/full_batch_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "previews_full_batch_v4_readme_depth_reuse", "label": "Depth Reuse Across Tuning Batches", "file_type": "rationale", "rationale": "Depth maps are reused from the v2 depth-source jobs across tuning batches because displacement/placement tuning does not change depth; v5 extends this to cross-workspace reuse (depth_reused_cross_workspace). Saves the expensive depth pass on every re-tune.", "source_file": "previews/full_batch_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "previews_full_batch_v4_readme_full_batch_v4_overview", "target": "previews_full_batch_v4_readme_continuous_displacement_ramp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "previews/full_batch_v4/README.md", "source_location": null, "weight": 1.0}, {"source": "previews_full_batch_v4_readme_full_batch_v4_overview", "target": "previews_full_batch_v4_readme_depth_reuse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour